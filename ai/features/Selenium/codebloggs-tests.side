  "tests": [
    {
      "id": "test-nav-01",
      "name": "Navigate All Pages",
      "commands": [
        {
          "id": "nav-01-c-pre",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "nav-01-c01-pre",
          "comment": "",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "nav-01-c00",
          "comment": "",
          "command": "executeScript",
          "target": "localStorage.clear(); sessionStorage.clear(); document.cookie = 'session_token=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/';",
