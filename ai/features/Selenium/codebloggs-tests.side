    {
      "id": "test-form-02",
      "name": "Register New User",
      "commands": [
        {
          "id": "form-02-c-pre1",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c01-pre",
          "comment": "",
          "command": "open",
          "target": "/register",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c-pre2",
          "comment": "",
          "command": "executeScript",
          "target": "localStorage.clear(); sessionStorage.clear(); document.cookie = 'session_token=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/';",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c01",
          "comment": "",
          "command": "open",
          "target": "/register",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c00",
          "comment": "",
          "command": "executeScript",
          "target": "var e='selenium.'+Date.now()+'@test.com'; localStorage.setItem('__regEmail',e); return e;",
          "targets": [],
          "value": "regEmail"
        },
        {
          "id": "form-02-c02",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('first_name');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'Selenium');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c03",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('last_name');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'Tester');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c04",
          "comment": "",
          "command": "executeScript",
          "target": "var email=localStorage.getItem('__regEmail');var e=document.getElementById('email');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,email);e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c05",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('birthdate');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'2000-01-01');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c06",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('password');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'selenium123');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c07",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('occupation');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'QA Engineer');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c08",
          "comment": "",
          "command": "executeScript",
          "target": "var e=document.getElementById('location');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(e,'London');e.dispatchEvent(new Event('input',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c09",
          "comment": "",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "form-02-c10",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "xpath=//p[contains(text(),'Registration successful')]",
          "targets": [],
          "value": "8000"
        },
        {
          "id": "form-02-c11",
          "comment": "",
          "command": "assertElementPresent",
          "target": "xpath=//p[contains(text(),'Registration successful')]",
          "targets": [],
          "value": ""
        }
      ]
