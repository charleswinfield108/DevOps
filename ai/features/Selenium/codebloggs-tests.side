          "target": "id=first_name",
          "targets": [],
          "value": ""
        },
        {
          "id": "nav-01-c05",
          "comment": "",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "nav-01-c05b",
          "comment": "",
